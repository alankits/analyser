# ─── HuggingFace LLM ─────────────────────────────────────────────────────────
HF_API_TOKEN=hf_your_token_here
HF_PRIMARY_MODEL=mistralai/Mistral-7B-Instruct-v0.3
HF_FALLBACK_MODEL=HuggingFaceH4/zephyr-7b-beta

# ─── Database ────────────────────────────────────────────────────────────────
# Local dev: SQLite (no setup required)
DATABASE_URL=sqlite+aiosqlite:///./resumeai.db

# Production (Railway): uncomment and fill in
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/resumeai

# ─── Redis (optional) ────────────────────────────────────────────────────────
# Leave blank to run without response caching
REDIS_URL=

# Production example:
# REDIS_URL=redis://default:password@host:6379

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ─── Limits ──────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=5
RATE_LIMIT_PER_MINUTE=10
